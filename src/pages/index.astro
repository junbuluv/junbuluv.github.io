---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { profiles } from '@/data/profiles';

const presentations = await getCollection('presentations');
const awards = await getCollection('awards');
const cv = await getEntry('materials', 'cv');

type FeedItem = {
  type: 'Presentation' | 'Award';
  text: string;
  year: number;
};

// "What's new" is scoped to the current calendar year only. Resolved at build
// time, so the feed auto-rolls each year without a code change.
const currentYear = new Date().getFullYear();

// All 4-digit years mentioned in a string ("2026–2027" → [2026, 2027]). An
// award counts as current if its span includes the current year.
const yearsIn = (year: string) => (year.match(/\d{4}/g) ?? []).map(Number);

// Brown bags are internal/departmental and don't belong in a public "What's
// new" feed; they still appear on the research page under each paper.
const isBrownBag = (venue: string) => /brown\s*bag/i.test(venue);

const feed: FeedItem[] = [
  ...presentations
    .filter((p) => !isBrownBag(p.data.venue) && p.data.year === currentYear)
    .map<FeedItem>((p) => ({
      type: 'Presentation',
      text: p.data.note ? `${p.data.venue} (${p.data.note})` : p.data.venue,
      year: currentYear,
    })),
  ...awards
    .filter((a) => a.data.includeInFeed && yearsIn(a.data.year).includes(currentYear))
    .map<FeedItem>((a) => ({
      type: 'Award',
      // Group under the current year even when the award spans into the next
      // (e.g. a 2026–2027 fellowship shows under 2026, not as a lone 2027).
      text: a.data.name,
      year: currentYear,
    })),
].slice(0, 8);

// Group the feed by year while preserving sort order.
const byYear = new Map<number, FeedItem[]>();
for (const item of feed) {
  const arr = byYear.get(item.year) ?? [];
  arr.push(item);
  byYear.set(item.year, arr);
}

function formatUpdated(iso: string): string {
  const [y, m] = iso.split('-');
  const monthName = new Date(Number(y), Number(m) - 1, 1).toLocaleString('en-US', {
    month: 'long',
  });
  return `${monthName} ${y}`;
}

const cvUpdatedLabel = cv ? formatUpdated(cv.data.updated) : '';

const description =
  'Jun Yoo is a Doctoral Candidate in Economics at The Graduate Center, CUNY. Research on information frictions, lender specialization, and small business lending.';
const keywords =
  'Jun Yoo, Hyun Jun Yoo, Jun Yoo CUNY, Jun Yoo economist, economics, finance, CUNY, Baruch College, Graduate Center CUNY, small business lending, lender specialization, banking, information frictions, soft information, private credit, doctoral candidate';
---

<BaseLayout
  title="Jun Yoo | Doctoral Candidate in Economics"
  description={description}
  keywords={keywords}
  canonical="https://junbuluv.github.io/"
  active="main"
  ogImage="https://junbuluv.github.io/headshot.jpg"
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Person',
        '@id': 'https://junbuluv.github.io/#person',
        name: 'Jun Yoo',
        givenName: 'Jun',
        familyName: 'Yoo',
        jobTitle: 'Doctoral Candidate in Economics',
        affiliation: [
          { '@type': 'EducationalOrganization', name: 'The Graduate Center, CUNY' },
          { '@type': 'EducationalOrganization', name: 'Baruch College, Zicklin School of Business, CUNY' },
        ],
        url: 'https://junbuluv.github.io',
        image: 'https://junbuluv.github.io/headshot.jpg',
        email: ['hyunjun.yoo@baruch.cuny.edu', 'hyoo1@gc.cuny.edu'],
        sameAs: profiles.map((p) => p.url),
        knowsAbout: [
          'Banking',
          'Small Business Lending',
          'Private Credit',
          'Information Frictions',
          'Lender Specialization',
          'Soft Information',
        ],
      },
    ],
  })} />

  <section class="reveal border-b border-rule py-12">
    <div class="flex flex-col items-start gap-10 sm:flex-row">
      <div
        class="h-[300px] w-[240px] min-w-[240px] overflow-hidden rounded border border-rule bg-cream-alt sm:h-[350px] sm:w-[280px] sm:min-w-[280px]"
      >
        <img src="/headshot.jpg" alt="Jun Yoo" class="h-full w-full object-cover" />
      </div>
      <div>
        <h1 class="mb-1 text-[1.8rem] font-bold">Jun Yoo</h1>
        <p class="mb-1 text-[1.05rem] text-ink-soft">Doctoral Candidate in Economics</p>
        <p class="mb-4 text-[0.95rem] text-ink-soft">
          The Graduate Center, CUNY &amp; Baruch College, Zicklin School of Business
        </p>
        <p class="mb-3 text-[0.98rem]">
          Hi! My name is Jun Yoo, and I am a Doctoral candidate at The Graduate Center, CUNY and
          Baruch College. I study how information frictions and regulatory design shape small
          business credit markets. My work examines lender specialization, discretion, and the role
          of soft information.
        </p>
        <p class="mb-4 text-[0.95rem] text-ink-soft">
          <strong class="text-ink">Fields:</strong> Banking, Small Business Lending, Private Credit
        </p>
        {
          cv && (
            <p class="mt-5">
              <a
                href={cv.data.file}
                class="inline-block rounded border border-burgundy px-5 py-2 text-[0.93rem] transition-colors hover:bg-burgundy hover:text-white hover:no-underline"
              >
                Download CV (PDF)
              </a>
              <span class="ml-3 text-[0.8rem] text-ink-soft">
                Latest version: {cvUpdatedLabel}
              </span>
            </p>
          )
        }
      </div>
    </div>
  </section>

  <section class="reveal py-10">
    <h2 class="mb-5 inline-block border-b border-burgundy pb-1 text-[1.3rem] font-bold text-ink">What's new</h2>
    <div class="space-y-6">
      {
        [...byYear.entries()].map(([year, items]) => (
          <div class="reveal">
            <h3 class="mb-2 text-[0.95rem] font-semibold tracking-wide text-burgundy">{year}</h3>
            <ul class="space-y-2.5">
              {items.map((item) => (
                <li class="card flex items-start gap-3 text-[0.95rem] leading-snug">
                  <span class="mt-[1px] inline-block whitespace-nowrap rounded-md border border-burgundy-line bg-burgundy-tint px-2 py-[2px] text-[0.7rem] uppercase tracking-wide text-burgundy">
                    {item.type}
                  </span>
                  <span>{item.text}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
