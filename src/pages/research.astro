---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

const papers = (await getCollection('papers')).sort(
  (a, b) => a.data.order - b.data.order,
);

const description =
  'Research by Jun Yoo on information frictions, lender specialization, and small business lending.';
const keywords =
  'Jun Yoo research, lender specialization, credit scoring, SBA, small business lending, information frictions, soft information, discretion, collateral, banking research';

const ldGraph = papers.map((p) => ({
  '@type': 'ScholarlyArticle',
  name: p.data.title,
  author: { '@id': 'https://junbuluv.github.io/#person' },
  abstract: p.data.abstract.slice(0, 320),
  ...(p.data.url ? { url: p.data.url } : {}),
}));
---

<BaseLayout
  title="Research | Jun Yoo"
  description={description}
  keywords={keywords}
  canonical="https://junbuluv.github.io/research.html"
  active="research"
>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': ldGraph })}
  />

  <section class="reveal border-b border-rule py-12 last:border-b-0">
    <h2 class="mb-5 inline-block border-b border-burgundy pb-1 text-[1.3rem] font-bold text-ink">Working Papers</h2>
    <ol class="list-decimal space-y-5 pl-6 marker:font-semibold marker:text-burgundy">
      {
        papers.map((paper) => (
          <li class="card reveal text-[0.98rem] leading-relaxed">
            <strong>{paper.data.title}</strong>
            {paper.data.url && (
              <>
                <br />
                <a
                  href={paper.data.url}
                  target="_blank"
                  rel="noopener"
                  class="mt-1 inline-block text-[0.88rem]"
                >
                  [{paper.data.urlLabel}]
                </a>
              </>
            )}
            {paper.data.status && (
              <em class="ml-2 text-ink-soft">&mdash; {paper.data.status}</em>
            )}
            {paper.data.coauthors && (
              <>
                <br />
                <span class="text-[0.95rem]">{paper.data.coauthors.join(', ')}</span>
              </>
            )}
            <div class="abstract-wrapper mt-2">
              <button class="abstract-toggle" aria-expanded="false">
                [Show Abstract]
              </button>
              <div class="abstract-content" aria-hidden="true">
                <div>
                  <p class="py-2 text-[0.9rem] leading-relaxed text-ink-soft">
                    {paper.data.abstract}
                  </p>
                </div>
              </div>
            </div>
            {paper.data.presentations && paper.data.presentations.length > 0 && (
              <p class="mt-2 text-[0.88rem] italic text-ink-soft">
                Presented at: {paper.data.presentations.join('; ')}
              </p>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <script>
    function armAbstracts() {
      document.querySelectorAll<HTMLElement>('.abstract-wrapper').forEach((wrap) => {
        const btn = wrap.querySelector<HTMLButtonElement>('.abstract-toggle');
        const content = wrap.querySelector<HTMLElement>('.abstract-content');
        if (!btn || !content || btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', () => {
          const open = wrap.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', String(open));
          content.setAttribute('aria-hidden', String(!open));
          btn.textContent = open ? '[Hide Abstract]' : '[Show Abstract]';
        });
      });
    }
    document.addEventListener('astro:page-load', armAbstracts);
  </script>
</BaseLayout>
