---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

const papers = (await getCollection('papers')).sort(
  (a, b) => a.data.order - b.data.order,
);

// Sections mirror the CV. The job market paper is a single featured card,
// so its list is unnumbered; empty sections are skipped.
const sections = [
  { title: 'Job Market Paper', numbered: false },
  { title: 'Working Papers', numbered: true },
  { title: 'Work in Progress', numbered: true },
] as const;
const grouped = sections
  .map((s) => ({ ...s, papers: papers.filter((p) => p.data.section === s.title) }))
  .filter((s) => s.papers.length > 0);

const description =
  'Research by Jun Yoo on financial intermediation and small-business lending: lender specialization, credit guarantees, debtor protection, and CLO risk-taking.';
const keywords =
  'Jun Yoo research, Jun Yoo job market paper, lender specialization, credit scoring, SBA, SBA 7(a), credit guarantees, small business lending, homestead exemption, home equity, collateral, collateralized loan obligations, CLO, information frictions, financial intermediation, banking research';

const ldGraph = papers.map((p) => ({
  '@type': 'ScholarlyArticle',
  name: p.data.title,
  author: { '@id': 'https://junbuluv.github.io/#person' },
  ...(p.data.abstract ? { abstract: p.data.abstract.slice(0, 320) } : {}),
  ...(p.data.url ? { url: p.data.url } : {}),
}));
---

<BaseLayout
  title="Research | Jun Yoo"
  description={description}
  keywords={keywords}
  canonical="https://junbuluv.github.io/research.html"
  active="research"
>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': ldGraph })}
  />

  {
    grouped.map((section) => (
      <section class="reveal border-b border-rule py-12 last-of-type:border-b-0">
        <h2 class="mb-5 inline-block border-b border-navy pb-1 text-[1.3rem] font-bold text-ink">{section.title}</h2>
        <ol
          class:list={[
            'space-y-5',
            section.numbered
              ? 'list-decimal pl-6 marker:font-semibold marker:text-navy'
              : 'list-none',
          ]}
        >
          {section.papers.map((paper) => (
            <li class="card reveal text-[0.98rem] leading-relaxed">
              <strong>{paper.data.title}</strong>
              {paper.data.url && (
                <>
                  <br />
                  <a
                    href={paper.data.url}
                    target="_blank"
                    rel="noopener"
                    class="mt-1 inline-block text-[0.88rem]"
                  >
                    [{paper.data.urlLabel}]
                  </a>
                </>
              )}
              {paper.data.status && (
                <em class="ml-2 text-ink-soft">&mdash; {paper.data.status}</em>
              )}
              {paper.data.coauthors && (
                <>
                  <br />
                  <span class="text-[0.95rem]"
                    >with {new Intl.ListFormat('en', { type: 'conjunction' }).format(
                      paper.data.coauthors
                    )}</span
                  >
                </>
              )}
              {paper.data.abstract && (
                <div class="abstract-wrapper mt-2">
                  <button class="abstract-toggle" aria-expanded="false">
                    [Show Abstract]
                  </button>
                  <div class="abstract-content" aria-hidden="true">
                    <div>
                      <p class="py-2 text-[0.9rem] leading-relaxed text-ink-soft">
                        {paper.data.abstract}
                      </p>
                    </div>
                  </div>
                </div>
              )}
              {paper.data.presentations && paper.data.presentations.length > 0 && (
                <p class="mt-2 text-[0.88rem] italic text-ink-soft">
                  Presented at: {paper.data.presentations.join(', ')}
                </p>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  <script>
    function armAbstracts() {
      document.querySelectorAll<HTMLElement>('.abstract-wrapper').forEach((wrap) => {
        const btn = wrap.querySelector<HTMLButtonElement>('.abstract-toggle');
        const content = wrap.querySelector<HTMLElement>('.abstract-content');
        if (!btn || !content || btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', () => {
          const open = wrap.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', String(open));
          content.setAttribute('aria-hidden', String(!open));
          btn.textContent = open ? '[Hide Abstract]' : '[Show Abstract]';
        });
      });
    }
    document.addEventListener('astro:page-load', armAbstracts);
  </script>
</BaseLayout>
