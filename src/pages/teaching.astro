---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

const courses = (await getCollection('teaching')).sort(
  (a, b) => a.data.order - b.data.order,
);

const institutions: ('Baruch College, CUNY' | 'Queens College, CUNY')[] = [
  'Baruch College, CUNY',
  'Queens College, CUNY',
];

const description = 'Teaching experience of Jun Yoo at Baruch College and Queens College, CUNY.';
const keywords =
  'Jun Yoo teaching, Queens College CUNY, Baruch College CUNY, macroeconomics, microeconomics, money and banking, corporate finance';
---

<BaseLayout
  title="Teaching | Jun Yoo"
  description={description}
  keywords={keywords}
  canonical="https://junbuluv.github.io/teaching.html"
  active="teaching"
>
  <section class="reveal border-b border-rule py-12 last:border-b-0">
    <h2 class="mb-5 text-[1.3rem] font-bold text-ink">Teaching</h2>
    {
      institutions.map((institution) => {
        const items = courses.filter((c) => c.data.institution === institution);
        if (items.length === 0) return null;
        return (
          <>
            <h3 class="mb-2 mt-4 text-[1rem] font-semibold text-ink-soft">{institution}</h3>
            <ul class="list-none pl-0">
              {items.map((course) => {
                // Role and semesters share one muted meta line beneath the
                // title: "Adjunct Lecturer · Spring 2026". Role is always
                // present (schema default); semesters are optional.
                const meta = [course.data.role, course.data.semesters?.join(', ')]
                  .filter(Boolean)
                  .join(' · ');
                return (
                  <li class="py-1 text-[0.95rem]">
                    <div>
                      {course.data.code} &mdash; {course.data.title}
                      {course.data.websiteUrl && (
                        <>
                          {' '}
                          <a href={course.data.websiteUrl} target="_blank" rel="noopener">
                            [course website]
                          </a>
                        </>
                      )}
                    </div>
                    <div class="text-[0.85rem] text-ink-soft">{meta}</div>
                  </li>
                );
              })}
            </ul>
          </>
        );
      })
    }
  </section>
</BaseLayout>
